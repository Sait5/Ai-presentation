# Copy to server/.env; use a separate local development database.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ai_documents:CHANGE_ME@127.0.0.1:5432/ai_documents?schema=public
# Required: generate at least 48 random characters locally; never commit.
JWT_SECRET=
# Gemini text generation: use an AI Studio Free Tier project without billing.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional paid provider. Used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
